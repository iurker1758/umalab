# Copy to .env (same directory) and adjust. .env is gitignored; never commit it.
# Real environment variables override anything set here.

# Async SQLAlchemy URL for the app and Alembic migrations.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/umalab

# uma.moe API key, used only by scripts/build_reference_data.py (never at
# app runtime). Get one from your uma.moe account.
UMA_MOE_API_KEY=

# ---------- identity (DECISIONS.md #32) ----------
# ACCESS_AUD is the switch. Leave it EMPTY for local development: the app then
# runs as DEV_USER_EMAIL, because nothing puts Cloudflare Access in front of
# `uvicorn --reload`, pytest or the Playwright suite.
#
# SET IT IN A DEPLOYMENT, to the Access application's AUD tag. Every request
# must then carry a JWT that verifies against the team's keys, and there is no
# fallback to DEV_USER_EMAIL — that is the point of one setting deciding.
ACCESS_AUD=
# Your Zero Trust team domain, e.g. myteam.cloudflareaccess.com. Required
# whenever ACCESS_AUD is set; it's where the signing keys are published.
ACCESS_TEAM_DOMAIN=

# Who the app is when ACCESS_AUD is empty, and — on the first upgrade past
# a3c71e5d9b04 — the owner every pre-existing row is assigned to. Set this to
# the email you will log in with through Access BEFORE running that migration
# if you want your existing roster to come with you.
DEV_USER_EMAIL=dev@localhost
