# Copy to .env (same directory) and adjust. .env is gitignored; never commit it.
# Real environment variables override anything set here.

# Async SQLAlchemy URL for the app and Alembic migrations.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/umalab

# uma.moe API key, used only by scripts/build_reference_data.py (never at
# app runtime). Get one from your uma.moe account.
UMA_MOE_API_KEY=

# ---------- identity (DECISIONS.md #58) ----------
# DISCORD_CLIENT_ID is the switch. Leave it EMPTY for local development: the
# app then runs as DEV_USER_EMAIL, because nothing puts a login in front of
# `uvicorn --reload`, pytest or the Playwright suite.
#
# SET IT IN A DEPLOYMENT, to your Discord application's client id. Every
# identity-bearing request (all but the reference-data routes, issue #116)
# must then carry a session cookie minted by a Discord login that
# holds one of DISCORD_ROLE_IDS in DISCORD_GUILD_ID, and there is no fallback
# to DEV_USER_EMAIL — that is the point of one setting deciding. All of the
# following are required whenever it is set.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The server whose roles are the invite list (right-click → Copy Server ID
# with Developer Mode on), and the role ids, comma-separated, any one of
# which admits a member.
DISCORD_GUILD_ID=
DISCORD_ROLE_IDS=
# The origin the browser sees, e.g. https://umalab.example.com. It is the
# OAuth redirect target — register <PUBLIC_ORIGIN>/api/auth/callback on the
# Discord application — and the only Origin a write may carry.
PUBLIC_ORIGIN=
# How long a login lasts. Absolute, not sliding: the role check runs at
# login, so this is also how long a removed role keeps working.
SESSION_TTL_DAYS=7

# Who the app is when DISCORD_CLIENT_ID is empty, and — on the first upgrade
# past a3c71e5d9b04 — the owner every pre-existing row is assigned to.
DEV_USER_EMAIL=dev@localhost
